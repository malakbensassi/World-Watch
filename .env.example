# WorldWatch Backend Environment Configuration

# 1. JWT Secret (must be at least 32 characters long)
JWT_SECRET=super_secret_worldwatch_jwt_key_2026_production_safe_token_32chars

# 2. Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=dummy_gemini_key

# 3. ExchangeRate API Key (get from https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=dummy_exchange_key

# 4. NewsAPI Key (get from https://newsapi.org/)
NEWS_API_KEY=dummy_news_key

# 5. MySQL Database Credentials
DB_USERNAME=root
DB_PASSWORD=
